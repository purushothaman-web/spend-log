# Server Configuration
PORT=5000
NODE_ENV=development

# Database
# Replace with your MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/spend-log

# Authentication Secrets
# Generate strong random strings for these (e.g., using `openssl rand -hex 32`)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here

# Email Configuration (SMTP)
# Use a service like Mailtrap for development or SendGrid/Gmail for production
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USER=username
MAIL_PASS=password
MAIL_FROM=no-reply@spendlog.com

# CORS & URL Configuration
# Where is your frontend running?
CORS_ORIGIN=http://localhost:3000
# URL used in email links
FRONTEND_URL=http://localhost:3000
